# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# Inside docker compose the api reaches Postgres at host "db"; from your host use localhost.
DATABASE_URL=postgresql+asyncpg://hr_agent:hr_agent@localhost:5432/hr_agent

# Policy search. "fastembed" downloads BAAI/bge-small-en-v1.5 (~130 MB) from Hugging Face once.
# "hashing" needs no download (offline/tests) but is keyword-like, not semantic.
EMBEDDING_PROVIDER=fastembed

# LLM. Get a free Gemini API key at https://aistudio.google.com (no card needed).
# Never commit the real key: .env is git-ignored.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
# LLM_THINKING_LEVEL=low   # Gemini 3: minimal|low|medium|high (thinking tokens use the output budget)
GOOGLE_API_KEY=
# Google Cloud "Express mode" key instead of an AI Studio key: also set
# GOOGLE_GENAI_USE_VERTEXAI=true
# Any OpenAI-compatible API with tool calling instead of Gemini, e.g. Groq (free tier):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a tool-calling model listed by the provider>
# LLM_API_KEY=

# Sessions. Generate a secret once, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=false

# Demo conveniences (keep false in any shared deployment)
AUTH_DEV_LOGIN_ENABLED=true
MOCK_HR_AUTOPROVISION=true

# Google sign-in (OAuth client from Google Cloud Console; redirect URI below must match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=ideas2it.com
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional tracing with LangSmith (third-party; traces include prompts and policy excerpts).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-chat-agent
LANGSMITH_HIDE_IO=false
